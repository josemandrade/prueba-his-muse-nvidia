<https://josemandrade.github.io/prueba-his-muse-nvidia/school-vision-screening/ImplementationGuide/school-vision-screening> a fhir:ImplementationGuide ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "school-vision-screening"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide school-vision-screening</b></p><a name=\"school-vision-screening\"> </a><a name=\"hcschool-vision-screening\"> </a><h2>SchoolVisionScreening</h2><p>The official URL for this implementation guide is: </p><pre>https://josemandrade.github.io/prueba-his-muse-nvidia/school-vision-screening/ImplementationGuide/school-vision-screening</pre><div><p>FHIR Implementation Guide for School Vision Screening interoperability. Defines profiles, operations, and examples for the exchange of vision screening results, referrals to ophthalmology, and assessment feedback between school health services, ophthalmology clinics, and primary care teams.\nThis guide implements the workflow described in the School Vision Screening use case: school nurse screens visual acuity → refers to ophthalmology if abnormal → receives assessment summary → generates teacher accommodation notice → sends results to primary care for health record.\nKey interoperability points: - IP-1: Screening result capture (Observation panel) - IP-2: Referral dispatch and tracking (360X ServiceRequest + Task) - IP-3: Assessment return (DiagnosticReport + Observations + CarePlan) - IP-4: Primary care receives screening/assessment documents (MHD) - IP-5: Teacher accommodation notice (Communication)</p>\n</div></div>"
  ] ;
  fhir:ImplementationGuide.url [ fhir:value "https://josemandrade.github.io/prueba-his-muse-nvidia/school-vision-screening/ImplementationGuide/school-vision-screening"] ;
  fhir:ImplementationGuide.version [ fhir:value "0.1.0"] ;
  fhir:ImplementationGuide.name [ fhir:value "SchoolVisionScreening"] ;
  fhir:ImplementationGuide.status [ fhir:value "draft"] ;
  fhir:ImplementationGuide.date [ fhir:value "2026-11-21T14:59:50+00:00"^^xsd:dateTime] ;
  fhir:ImplementationGuide.description [ fhir:value "FHIR Implementation Guide for School Vision Screening interoperability. Defines profiles, operations, and examples for the exchange of vision screening results, referrals to ophthalmology, and assessment feedback between school health services, ophthalmology clinics, and primary care teams.\nThis guide implements the workflow described in the School Vision Screening use case: school nurse screens visual acuity → refers to ophthalmology if abnormal → receives assessment summary → generates teacher accommodation notice → sends results to primary care for health record.\nKey interoperability points: - IP-1: Screening result capture (Observation panel) - IP-2: Referral dispatch and tracking (360X ServiceRequest + Task) - IP-3: Assessment return (DiagnosticReport + Observations + CarePlan) - IP-4: Primary care receives screening/assessment documents (MHD) - IP-5: Teacher accommodation notice (Communication)\n"] ;
  fhir:ImplementationGuide.packageId [ fhir:value "school-vision-screening"] ;
  fhir:ImplementationGuide.license [ fhir:value "CC0-1.0"] ;
