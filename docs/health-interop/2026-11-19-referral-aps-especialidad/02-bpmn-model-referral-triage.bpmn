<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ddi="http://www.omg.org/spec/DD/20100524/DI" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" id="defs_referral-triage" targetNamespace="http://example.org/referral/referral-triage" exporter="build_bpmn.py" exporterVersion="1.0">
  <collaboration id="collab_referral-triage">
    <participant id="P_APS" name="APS (CESFAM Los Aromos)" processRef="proc_P_APS" />
    <participant id="P_MPI" name="MPI (master patient index)" processRef="proc_P_MPI" />
    <participant id="P_HUB" name="Referral hub" processRef="proc_P_HUB" />
    <participant id="P_SPEC" name="Specialty (cardiology)" processRef="proc_P_SPEC" />
    <participant id="P_PAT" name="Patient" processRef="proc_P_PAT" />
    <messageFlow id="m1" name="Resolve identity (request)" sourceRef="t_mpi" targetRef="t_mpi_lookup" />
    <messageFlow id="m2" name="Identity resolved (MPI key)" sourceRef="t_mpi_lookup" targetRef="t_mpi" />
    <messageFlow id="m3" name="PI-0 referral (minimum data set)" sourceRef="t_create" targetRef="t_hub_receive" />
    <messageFlow id="m11" name="PI-0 referral routed to specialty" sourceRef="t_hub_route" targetRef="t_triage" />
    <messageFlow id="m12" name="Rejection notice to patient" sourceRef="t_notify_reject" targetRef="t_pat_notice2" />
    <messageFlow id="m4" name="PI-1 acceptance" sourceRef="t_accept" targetRef="t_fwd_accept" />
    <messageFlow id="m5" name="PI-1 rejection with reason" sourceRef="t_reject" targetRef="t_fwd_reject" />
    <messageFlow id="m6" name="PI-1 acceptance to APS" sourceRef="t_fwd_accept" targetRef="t_receive_accept" />
    <messageFlow id="m7" name="PI-1 rejection to APS" sourceRef="t_fwd_reject" targetRef="t_notify_reject" />
    <messageFlow id="m8" name="Referral creation notice" sourceRef="t_inform_create" targetRef="t_pat_create" />
    <messageFlow id="m9" name="Accept / reject notice" sourceRef="t_receive_accept" targetRef="t_pat_notice2" />
    <messageFlow id="m10" name="Escalation: re-triage timeout" sourceRef="t_esc_req" targetRef="t_hub_esc_retriage" />
  </collaboration>
  <process id="proc_P_APS" isExecutable="false">
    <laneSet id="lanes_P_APS">
      <lane id="L_DOC" name="APS doctor">
        <flowNodeRef>e_start</flowNodeRef>
        <flowNodeRef>g_patient</flowNodeRef>
        <flowNodeRef>t_decline</flowNodeRef>
        <flowNodeRef>e_end_decline</flowNodeRef>
        <flowNodeRef>t_mpi</flowNodeRef>
        <flowNodeRef>t_create</flowNodeRef>
        <flowNodeRef>t_resolve</flowNodeRef>
        <flowNodeRef>e_end_resolve</flowNodeRef>
        <flowNodeRef>t_retriage</flowNodeRef>
        <flowNodeRef>b_retriage</flowNodeRef>
        <flowNodeRef>g_retriage</flowNodeRef>
        <flowNodeRef>t_rerefer</flowNodeRef>
        <flowNodeRef>e_end_rerefer</flowNodeRef>
        <flowNodeRef>t_diffspecialty</flowNodeRef>
        <flowNodeRef>e_end_diff</flowNodeRef>
        <flowNodeRef>t_esc_req</flowNodeRef>
      </lane>
      <lane id="L_ADM" name="APS admin">
        <flowNodeRef>t_inform_create</flowNodeRef>
        <flowNodeRef>t_notify_reject</flowNodeRef>
        <flowNodeRef>t_receive_accept</flowNodeRef>
        <flowNodeRef>e_end_accept</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="e_start" name="Specialty assessment needed" />
    <exclusiveGateway id="g_patient" name="Patient accepts referral?" />
    <task id="t_decline" name="Record declined referral in APS record" />
    <endEvent id="e_end_decline" name="No referral created" />
    <task id="t_mpi" name="Resolve patient identity via MPI" />
    <task id="t_create" name="Create referral (minimum data set)" />
    <task id="t_resolve" name="Resolve in APS" />
    <endEvent id="e_end_resolve" name="Resolved in APS; closed as rejected" />
    <task id="t_retriage" name="Re-triage within 5 working days" />
    <boundaryEvent id="b_retriage" name="5 working days" attachedToRef="t_retriage" cancelActivity="false">
      <timerEventDefinition id="b_retriage_timerdef" />
    </boundaryEvent>
    <exclusiveGateway id="g_retriage" name="Re-triage outcome?" />
    <task id="t_rerefer" name="Re-refer with more information" />
    <endEvent id="e_end_rerefer" name="New referral; first closed as rejected" />
    <task id="t_diffspecialty" name="Refer to different specialty" />
    <endEvent id="e_end_diff" name="New referral to different specialty; first closed as rejected" />
    <task id="t_esc_req" name="Notify hub: re-triage timeout" />
    <task id="t_inform_create" name="Inform patient of referral creation" />
    <task id="t_notify_reject" name="Receive rejection; inform APS doctor" />
    <task id="t_receive_accept" name="Receive acceptance; inform patient and APS doctor" />
    <endEvent id="e_end_accept" name="Accepted — see Part B" />
    <sequenceFlow id="f1" name="" sourceRef="e_start" targetRef="g_patient" />
    <sequenceFlow id="f2" name="yes" sourceRef="g_patient" targetRef="t_mpi" />
    <sequenceFlow id="f3" name="no" sourceRef="g_patient" targetRef="t_decline" />
    <sequenceFlow id="f4" name="" sourceRef="t_decline" targetRef="e_end_decline" />
    <sequenceFlow id="f5" name="" sourceRef="t_mpi" targetRef="t_create" />
    <sequenceFlow id="f6" name="rejection received" sourceRef="t_notify_reject" targetRef="t_retriage" />
    <sequenceFlow id="f7" name="" sourceRef="t_retriage" targetRef="g_retriage" />
    <sequenceFlow id="f8" name="re-refer" sourceRef="g_retriage" targetRef="t_rerefer" />
    <sequenceFlow id="f9" name="different specialty" sourceRef="g_retriage" targetRef="t_diffspecialty" />
    <sequenceFlow id="f10" name="resolve in APS" sourceRef="g_retriage" targetRef="t_resolve" />
    <sequenceFlow id="f11" name="" sourceRef="t_rerefer" targetRef="e_end_rerefer" />
    <sequenceFlow id="f12" name="" sourceRef="t_diffspecialty" targetRef="e_end_diff" />
    <sequenceFlow id="f13" name="" sourceRef="t_resolve" targetRef="e_end_resolve" />
    <sequenceFlow id="f14" name="timeout" sourceRef="b_retriage" targetRef="t_esc_req" />
    <sequenceFlow id="f15" name="" sourceRef="t_create" targetRef="t_inform_create" />
    <sequenceFlow id="f16" name="" sourceRef="t_receive_accept" targetRef="e_end_accept" />
  </process>
  <process id="proc_P_MPI" isExecutable="false">
    <laneSet id="lanes_P_MPI">
      <lane id="L_MPI" name="MPI">
        <flowNodeRef>t_mpi_lookup</flowNodeRef>
      </lane>
    </laneSet>
    <task id="t_mpi_lookup" name="Resolve patient identity (MPI key)" />
  </process>
  <process id="proc_P_HUB" isExecutable="false">
    <laneSet id="lanes_P_HUB">
      <lane id="L_HUB" name="Hub operator">
        <flowNodeRef>t_hub_receive</flowNodeRef>
        <flowNodeRef>t_hub_route</flowNodeRef>
        <flowNodeRef>g_wait</flowNodeRef>
        <flowNodeRef>g_decision</flowNodeRef>
        <flowNodeRef>t_fwd_accept</flowNodeRef>
        <flowNodeRef>t_fwd_reject</flowNodeRef>
        <flowNodeRef>t_escalate</flowNodeRef>
        <flowNodeRef>t_hub_esc_retriage</flowNodeRef>
        <flowNodeRef>e_end_hubesc</flowNodeRef>
        <flowNodeRef>e_cancel_start_a</flowNodeRef>
        <flowNodeRef>t_cancel_a</flowNodeRef>
        <flowNodeRef>e_end_cancel_a</flowNodeRef>
      </lane>
    </laneSet>
    <task id="t_hub_receive" name="Receive referral" />
    <task id="t_hub_route" name="Route to requested specialty service" />
    <exclusiveGateway id="g_wait" name="Decision received?" />
    <exclusiveGateway id="g_decision" name="Accept?" />
    <task id="t_fwd_accept" name="Forward acceptance to APS" />
    <task id="t_fwd_reject" name="Forward rejection to APS" />
    <task id="t_escalate" name="Escalate to specialty; notify APS" />
    <task id="t_hub_esc_retriage" name="Escalate to APS (notify admin + doctor)" />
    <endEvent id="e_end_hubesc" name="Escalation recorded" />
    <startEvent id="e_cancel_start_a" name="Cancellation requested (APS / patient / specialty)">
      <messageEventDefinition id="e_cancel_start_a_msgdef" />
    </startEvent>
    <task id="t_cancel_a" name="Record cancellation (incl. patient death); notify all parties" />
    <endEvent id="e_end_cancel_a" name="Cancelled (terminal)" />
    <sequenceFlow id="f18" name="" sourceRef="t_hub_receive" targetRef="t_hub_route" />
    <sequenceFlow id="f19" name="" sourceRef="t_hub_route" targetRef="g_wait" />
    <sequenceFlow id="f20" name="decision received" sourceRef="g_wait" targetRef="g_decision" />
    <sequenceFlow id="f21" name="timeout — 5 working days (2 if urgent)" sourceRef="g_wait" targetRef="t_escalate" />
    <sequenceFlow id="f22" name="still waiting" sourceRef="t_escalate" targetRef="g_wait" />
    <sequenceFlow id="f23" name="accepted" sourceRef="g_decision" targetRef="t_fwd_accept" />
    <sequenceFlow id="f24" name="rejected" sourceRef="g_decision" targetRef="t_fwd_reject" />
    <sequenceFlow id="f25" name="" sourceRef="t_hub_esc_retriage" targetRef="e_end_hubesc" />
    <sequenceFlow id="f26" name="" sourceRef="e_cancel_start_a" targetRef="t_cancel_a" />
    <sequenceFlow id="f27" name="" sourceRef="t_cancel_a" targetRef="e_end_cancel_a" />
  </process>
  <process id="proc_P_SPEC" isExecutable="false">
    <laneSet id="lanes_P_SPEC">
      <lane id="L_TRI" name="Triage clinician / specialist">
        <flowNodeRef>t_triage</flowNodeRef>
        <flowNodeRef>g_triage</flowNodeRef>
        <flowNodeRef>t_accept</flowNodeRef>
        <flowNodeRef>e_end_accept_spec</flowNodeRef>
        <flowNodeRef>t_reject</flowNodeRef>
        <flowNodeRef>e_end_reject_spec</flowNodeRef>
      </lane>
    </laneSet>
    <task id="t_triage" name="Triage referral" />
    <exclusiveGateway id="g_triage" name="Accept or reject?" />
    <task id="t_accept" name="Accept referral (name service / practitioner)" />
    <endEvent id="e_end_accept_spec" name="Accepted — scheduling (Part B)" />
    <task id="t_reject" name="Reject referral with reason" />
    <endEvent id="e_end_reject_spec" name="Rejection sent (PI-1)" />
    <sequenceFlow id="f28" name="" sourceRef="t_triage" targetRef="g_triage" />
    <sequenceFlow id="f29" name="accepted" sourceRef="g_triage" targetRef="t_accept" />
    <sequenceFlow id="f30" name="rejected" sourceRef="g_triage" targetRef="t_reject" />
    <sequenceFlow id="f31" name="" sourceRef="t_accept" targetRef="e_end_accept_spec" />
    <sequenceFlow id="f32" name="" sourceRef="t_reject" targetRef="e_end_reject_spec" />
  </process>
  <process id="proc_P_PAT" isExecutable="false">
    <laneSet id="lanes_P_PAT">
      <lane id="L_PAT" name="Patient">
        <flowNodeRef>t_pat_create</flowNodeRef>
        <flowNodeRef>t_pat_notice2</flowNodeRef>
      </lane>
    </laneSet>
    <task id="t_pat_create" name="Receive referral creation notice" />
    <task id="t_pat_notice2" name="Receive acceptance / rejection notice" />
  </process>
