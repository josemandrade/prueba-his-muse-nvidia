        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        }
      },
      {
        "id": "Patient.extension:preferredContactChannel",
        "path": "Patient.extension",
        "sliceName": "preferredContactChannel",
        "short": "Canal preferido del paciente para las notificaciones",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://josemandrade.github.io/prueba-his-muse-nvidia/derivacion-aps-especialidad/StructureDefinition/derivacion-preferred-contact-channel"
            ]
          }
        ]
      },
      {
